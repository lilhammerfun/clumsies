{
	# Prometheus scrapes HTTP metrics on the admin endpoint. It stays on the
	# Compose network because only ports 80 and 443 are published.
	admin :2019
	metrics
}

app.clumsies.ai {
	encode zstd gzip
	log {
		output stdout
		format filter {
			wrap json {
				duration_format ms
			}
			request>headers delete
			request>uri delete
			resp_headers delete
		}
	}
	log_append request_id {http.request.uuid}
	log_append path {http.request.uri.path}
	log_append upstream_host {rp.upstream.host}
	log_append upstream_duration_ms {rp.upstream.duration_ms}
	log_append upstream_latency_ms {rp.upstream.latency_ms}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The metrics endpoint is for the internal Prometheus scrape only.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy server:8080 {
		header_up X-Request-ID {http.request.uuid}
	}
}

docs.clumsies.ai {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	root * /srv/docs
	try_files {path} {path}/ {path}.html
	file_server

	# Serve the VitePress 404 page with a real 404 status. Rewriting to
	# /404.html inside try_files would answer 200 and make misses look like
	# content to crawlers and uptime checks.
	handle_errors {
		@not_found expression {err.status_code} == 404
		rewrite @not_found /404.html
		file_server
	}
}

www.clumsies.ai {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	redir https://clumsies.ai{uri} permanent
}

clumsies.ai {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	root * /srv/www
	try_files {path} {path}/ /index.html
	file_server
}
