      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((time() - clumsies_backup_last_success_timestamp_seconds) / 3600) and on(job,instance) (((time() - clumsies_backup_last_success_timestamp_seconds) >= 0)) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) <= 900))) or on(job,instance) ((0 * clumsies_backup_last_success_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_backup_last_success_timestamp_seconds) < 0)) or on(job,instance) ((0 * clumsies_observability_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) < 0))",
          "legendFormat": "Backup age",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "clumsies_backup_last_success_timestamp_seconds * 1000",
          "legendFormat": "Recorded success timestamp · raw"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 26
              }
