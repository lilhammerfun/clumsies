          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(((0 * clumsies_release_last_success_timestamp_seconds + 1) and on(job,instance) ((time() - clumsies_release_last_success_timestamp_seconds) >= 0) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) <= 900))) or on(job,instance) ((0 * clumsies_release_last_success_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_release_last_success_timestamp_seconds) < 0)) or on(job,instance) ((0 * clumsies_observability_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) < 0)) or on(job,instance) (0 * up{job=\"node\"} - 1)) or on() vector(-1)",
