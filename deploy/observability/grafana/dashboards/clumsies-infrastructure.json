{
  "uid": "clumsies-infrastructure",
  "title": "Clumsies Infrastructure and Operations",
  "tags": [
    "clumsies",
    "en"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Shared dependencies, resources, evidence delivery and recovery. Use the same time window as the abnormal request; snapshot age and collection confidence come first.",
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/clumsies-overview/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Business API",
      "type": "link",
      "url": "/d/clumsies-api/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Entrance and websites",
      "type": "link",
      "url": "/d/clumsies-web/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Infrastructure and operations",
      "type": "link",
      "url": "/d/clumsies-infrastructure/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Product activity · API bottom section",
      "type": "link",
      "url": "/d/clumsies-api/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Expected scrape targets · 1 up / 0 down / -1 missing",
      "type": "table",
      "description": "Expected inventory is evaluated by Prometheus rules. Before those rules load, only discovered targets can be shown. Empty data is unknown, never healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clumsies_observability_target_health or on(job,instance) up",
          "legendFormat": "{{job}} · {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable / no samples — check collection",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Missing",
                  "color": "red"
                },
                "0": {
                  "text": "Down / failed",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Database reachability and snapshot confidence",
      "type": "stat",
      "description": "Exporter scrape success is distinct from PostgreSQL reachability. Snapshot confidence requires success and age <=15 minutes; stale/missing snapshots are -1, never green. Current evidence requires host and database collection ages from 0 to 900 seconds. Future timestamps are invalid; recorded values remain unchanged.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{job=\"postgres\"}",
          "legendFormat": "PostgreSQL reachable",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "((clumsies_database_collection_success and on(job,instance) (((time() - clumsies_database_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) <= 900)) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) <= 900))) or on(job,instance) ((0 * clumsies_database_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) < 0)) or on(job,instance) ((0 * clumsies_observability_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) < 0)) or on(job,instance) (0 * up{job=\"node\"} - 1)) or on() vector(-1)",
          "legendFormat": "DB snapshot: 1 success / 0 failed / -1 stale missing / -2 invalid time",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable / no samples — check collection",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Stale / missing",
                  "color": "red"
                },
                "0": {
                  "text": "Down / failed",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                },
                "-2": {
                  "text": "Invalid future timestamp",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Collection age · seconds",
      "type": "stat",
      "description": "Database snapshots older than 15 minutes are invalid for current decisions. Ages must be nonnegative; future collection timestamps are invalid.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((time() - clumsies_database_collection_timestamp_seconds) / 1) and on(job,instance) (((time() - clumsies_database_collection_timestamp_seconds) >= 0))) or on(job,instance) ((0 * clumsies_database_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) < 0))",
          "legendFormat": "Database snapshot",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(((time() - clumsies_observability_collection_timestamp_seconds) / 1) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0))) or on(job,instance) ((0 * clumsies_observability_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) < 0))",
          "legendFormat": "Host collector",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable / no samples — check collection",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "Invalid future timestamp",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Server connection pool",
      "type": "timeseries",
      "description": "Shared across routes. Used/idle/open/max are approximate concurrent snapshots; acquisition telemetry below covers only review create/merge transactions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(clumsies_db_pool_connections{job=\"server\"}) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(clumsies_db_pool_size{job=\"server\"}) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "Open",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(clumsies_db_pool_max_connections{job=\"server\"}) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "Configured max",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "description": "Compare database total capacity with the Server pool limit; increasing a pool may worsen database contention.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "Current",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "Configured max",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Pool acquire latency · review transactions only",
      "type": "timeseries",
      "description": "Includes waiting, validation and opening a connection, excludes BEGIN/transaction execution. Limited coverage; absent data is unsupported or idle, not zero wait.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95,sum by(le,operation,outcome)(rate(clumsies_db_pool_acquire_duration_seconds_bucket{job=\"server\",operation=~\"review_create|review_merge\"}[5m]))) and on(operation,outcome) (sum by(operation,outcome)(increase(clumsies_db_pool_acquire_duration_seconds_count{job=\"server\",operation=~\"review_create|review_merge\"}[5m])) > 0)) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{operation}} · {{outcome}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Pool acquisitions / second · review transactions only",
      "type": "timeseries",
      "description": "Acquired, timeout, error and cancelled/aborted results; limited to instrumented review transactions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(operation,outcome)(rate(clumsies_db_pool_acquires_total{job=\"server\",operation=~\"review_create|review_merge\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{operation}} · {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Acquisitions in progress · review transactions only",
      "type": "timeseries",
      "description": "Not a pure queue length: may include validating or opening connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(clumsies_db_pool_acquires_in_flight{job=\"server\",operation=~\"review_create|review_merge\"}) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Longest running query",
      "type": "timeseries",
      "description": "Active queries in the application database only, excluding this collector and idle-in-transaction sessions. Five-minute snapshot, valid only after successful fresh collection; it can miss short lock/query waits.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clumsies_db_longest_query_seconds and on(job,instance) ((clumsies_database_collection_success == 1) and on(job,instance) (((time() - clumsies_database_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) <= 900)) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) <= 900)))",
          "legendFormat": "seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Host CPU",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Host memory used",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Container CPU · cores",
      "type": "timeseries",
      "description": "CPU seconds per second = used cores; 0.5 means half a core.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"clumsies-.*\"}[5m]))",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Container memory",
      "type": "timeseries",
      "description": "Working set bytes. No configured memory limit is not unlimited host capacity; a fixed 2GiB alert is an operational reminder.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"clumsies-.*\"})",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Persistent filesystem free space",
      "type": "timeseries",
      "description": "Check root and the mounts that hold PostgreSQL, Loki and Prometheus data; compare I/O evidence before attributing request latency to disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/sys.*|/proc.*\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/sys.*|/proc.*\"} * 100",
          "legendFormat": "{{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "noValue": "Unavailable / no samples — check collection"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "Active fault alerts",
      "type": "table",
      "description": "Open Prometheus Alerts for expressions and Alertmanager for delivery/silences. Dependency faults remain visible here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}",
          "legendFormat": "{{alertname}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
