    {
      "id": 16,
      "title": "Backup age",
      "type": "timeseries",
      "description": "Last known successful backup age; the last success persists across failed attempts. Missing means never successful or unavailable, not zero age. Check the latest task state and collector age. Age requires host collection age 0–900 seconds and a non-future success timestamp. The raw success timestamp stays visible as a recorded fact, not current health.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
