    {
      "type": "timeseries",
      "title": "Requests by status code",
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
