      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(clumsies_http_business_requests_in_flight{job=\"server\",method!=\"\"})) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "In progress",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
