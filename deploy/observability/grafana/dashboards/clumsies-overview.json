    {
      "id": 1,
      "title": "Endpoint availability",
      "type": "timeseries",
      "description": "The App probe requires HTTP 200 and JSON status=ok; static sites use HTTPS probes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
