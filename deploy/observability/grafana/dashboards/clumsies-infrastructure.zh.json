{
  "uid": "clumsies-infrastructure-zh",
  "title": "Clumsies 基础设施与运行保障",
  "tags": [
    "clumsies",
    "zh"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "共享依赖、资源、证据传输及恢复；与异常请求使用同一时间窗，先确认快照年龄和采集可信度。",
  "links": [
    {
      "title": "运行总览",
      "type": "link",
      "url": "/d/clumsies-overview-zh/view",
      "includeVars": false,
