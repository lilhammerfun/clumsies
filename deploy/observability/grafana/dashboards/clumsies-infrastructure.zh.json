        }
      }
    },
    {
      "id": 14,
      "title": "持久文件系统可用空间",
      "type": "timeseries",
      "description": "检查根分区及承载 PostgreSQL/Loki/Prometheus 的实际挂载；判断磁盘导致延迟前还需 I/O 证据。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
