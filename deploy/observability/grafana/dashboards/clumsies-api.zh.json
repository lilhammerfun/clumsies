    {
      "id": 24,
      "title": "业务请求进入与终止 / 秒",
      "type": "timeseries",
      "description": "新业务口径排除健康检查与 metrics，使用 route/method 筛选。response 与 cancelled_or_aborted 分开；缺失可能是旧版本未提供或尚无样本，不能补零。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(clumsies_http_business_requests_started_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "进入",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum by(outcome)(rate(clumsies_http_business_requests_terminated_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
