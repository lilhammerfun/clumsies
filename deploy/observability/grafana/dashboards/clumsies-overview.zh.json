{
  "uid": "clumsies-overview-zh",
  "title": "Clumsies 运行总览",
  "tags": [
    "clumsies",
    "zh"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "业务请求性能、站点入口与采集状态。",
  "links": [
    {
      "title": "总览",
      "type": "link",
      "url": "/d/clumsies-overview-zh/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "API",
      "type": "link",
      "url": "/d/clumsies-api-zh/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "网站访问",
      "type": "link",
      "url": "/d/clumsies-web-zh/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "基础设施",
      "type": "link",
      "url": "/d/clumsies-infrastructure-zh/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 20,
      "title": "当前告警",
      "type": "stat",
      "description": "当前触发的故障告警数量，排除通知心跳。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}) or vector(0)) and on() (min(up{job=\"prometheus\"}) == 1)",
          "legendFormat": "告警",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未知",
          "links": [
            {
              "title": "基础设施",
              "url": "/d/clumsies-infrastructure-zh/view?${__url_time_range}",
              "targetBlank": false
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "未知",
                  "color": "#8e8e8e"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "未知",
                  "color": "#8e8e8e"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 21,
      "title": "采集状态",
      "type": "stat",
      "description": "数据库与主机快照有效期为15分钟，负年龄标为时间无效。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(clumsies_observability_target_health) or vector(-1)",
          "legendFormat": "采集目标",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "((clumsies_database_collection_success and on(job,instance) (((time() - clumsies_database_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) <= 900)) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) <= 900))) or on(job,instance) ((0 * clumsies_database_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) < 0)) or on(job,instance) ((0 * clumsies_observability_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) < 0)) or on(job,instance) (0 * up{job=\"node\"} - 1)) or on() vector(-1)",
          "legendFormat": "数据库采集",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "(((0 * clumsies_observability_collection_timestamp_seconds + 1) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) <= 900))) or on(job,instance) ((0 * clumsies_observability_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) < 0)) or on(job,instance) (0 * up{job=\"node\"} - 1)) or on() vector(-1)",
          "legendFormat": "主机采集",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未知",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "时间无效",
                  "color": "red"
                },
                "-1": {
                  "text": "缺失或过期",
                  "color": "orange"
                },
                "0": {
                  "text": "失败",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "未知",
                  "color": "#8e8e8e"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "未知",
                  "color": "#8e8e8e"
                }
              }
            }
          ],
          "links": [
            {
              "title": "基础设施",
              "url": "/d/clumsies-infrastructure-zh/view?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-2": {
                        "text": "时间无效",
                        "color": "red"
                      },
                      "-1": {
                        "text": "未知",
                        "color": "orange"
                      },
                      "0": {
                        "text": "失败",
                        "color": "red"
                      },
                      "1": {
                        "text": "正常",
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "未知",
                        "color": "#8e8e8e"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "nan",
                      "result": {
                        "text": "未知",
                        "color": "#8e8e8e"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 22,
      "title": "业务请求吞吐量",
      "type": "timeseries",
      "description": "业务 handler 的进入、响应与中断速率，使用5分钟窗口。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(clumsies_http_requests_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "响应",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(rate(clumsies_http_business_requests_started_total{job=\"server\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "进入",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(sum(rate(clumsies_http_business_requests_terminated_total{job=\"server\",outcome=\"cancelled_or_aborted\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "取消/中断",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "无数据",
          "links": [
            {
              "title": "业务 API",
              "url": "/d/clumsies-api-zh/view?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "title": "样本量",
      "type": "timeseries",
      "description": "5分钟窗口的响应样本外推量。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "总量",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",status_class=~\"2xx|3xx\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "成功",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",status_class=~\"4xx|5xx|other\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "错误",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 24,
      "title": "成功响应延迟",
      "type": "timeseries",
      "description": "2xx/3xx handler 响应的5分钟分位数，计时止于返回 Response。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.5, sum by(le) (rate(clumsies_http_request_duration_seconds_bucket{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",status_class=~\"2xx|3xx\",method!=\"\"}[5m]))) and (sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",status_class=~\"2xx|3xx\",method!=\"\"}[5m])) > 0)) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(histogram_quantile(0.95, sum by(le) (rate(clumsies_http_request_duration_seconds_bucket{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",status_class=~\"2xx|3xx\",method!=\"\"}[5m]))) and (sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",status_class=~\"2xx|3xx\",method!=\"\"}[5m])) > 0)) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "无数据",
          "links": [
            {
              "title": "业务 API",
              "url": "/d/clumsies-api-zh/view?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 25,
      "title": "5xx 比例",
      "type": "timeseries",
      "description": "5分钟窗口内5xx响应占全部业务响应的比例。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",status_class=\"5xx\"}[5m])) or 0 * sum(rate(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m]))) / (sum(rate(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m])) > 0) * 100) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 26,
      "title": "5xx 数量",
      "type": "timeseries",
      "description": "5分钟窗口内的5xx响应外推量。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 11,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",status_class=\"5xx\"}[5m])) or 0 * sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 27,
      "title": "业务请求并发",
      "type": "timeseries",
      "description": "当前执行中的业务 handler 数量。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(clumsies_http_business_requests_in_flight{job=\"server\",method!=\"\"})) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "执行中",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 28,
      "title": "连接池使用量",
      "type": "timeseries",
      "description": "Server 共享连接池的使用量与配置上限。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 11,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(clumsies_db_pool_connections{job=\"server\"}) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(clumsies_db_pool_max_connections{job=\"server\"}) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "上限",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据",
          "links": [
            {
              "title": "基础设施",
              "url": "/d/clumsies-infrastructure-zh/view?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "使用中"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "idle"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "空闲"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 1,
      "title": "站点可用性",
      "type": "timeseries",
      "description": "App 探针要求 HTTP 200 且 JSON status=ok；静态站点使用 HTTPS 探测。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox-public\"} and on(job,instance) (up{job=\"blackbox-public\"} == 1)",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "https://app.clumsies.ai/api/v1/admin/health"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "app.clumsies.ai"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "网站访问",
                    "url": "/d/clumsies-web-zh/view?${__url_time_range}&var-site=app.clumsies.ai",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "https://docs.clumsies.ai/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "docs.clumsies.ai"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "网站访问",
                    "url": "/d/clumsies-web-zh/view?${__url_time_range}&var-site=docs.clumsies.ai",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "https://clumsies.ai/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "clumsies.ai"
              },
              {
                "id": "links",
                "value": [
