          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 40,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "clumsies_drafts_created_last_hour",
              "legendFormat": "drafts / last 60m",
              "datasource": {
                "type": "prometheus",
