              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": null,
              "noValue": "No samples"
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi"
            }
          }
        },
        {
          "id": 12,
          "title": "Reviews created in the last hour",
          "type": "timeseries",
          "description": "Sampled every 5 minutes: retained rows created in the last 60 minutes. Deletions reduce the count. This is neither a lifetime event counter nor synchronization latency.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 47,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "clumsies_reviews_created_last_hour",
              "legendFormat": "reviews / last 60m",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": null,
