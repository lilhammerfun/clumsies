        {
          "id": 17,
          "title": "Oldest open Draft age since creation (days)",
          "type": "timeseries",
          "description": "Time since created_at; recent edits do not reset this age. Zero when no open Draft exists. Not inactivity, synchronization latency or a processing deadline.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 61,
            "w": 12,
            "h": 7
          },
          "targets": [
