            }
          }
        },
        {
          "id": 13,
          "title": "Drafts by lifecycle state",
          "type": "timeseries",
          "description": "Includes open, submitted, merged and discarded. Merged/discarded are historical states; open Drafts can remain in active use. Counts do not imply a service backlog.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 47,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "clumsies_drafts",
              "legendFormat": "{{status}}",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": null,
              "noValue": "No samples"
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi"
            }
          }
        },
        {
          "id": 14,
          "title": "Open Draft net change per hour",
          "type": "timeseries",
          "description": "Hourly slope of the last 6 hours of stored open Draft counts. Includes creation, reopening, submission, discard and deletion; not creation throughput or processing latency.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 54,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "deriv(clumsies_drafts{status=\"open\"}[6h]) * 3600",
              "legendFormat": "drafts/h",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": null,
              "noValue": "No samples"
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi"
            }
          }
        },
        {
          "id": 15,
          "title": "Drafts with current reconciliation conflicts",
          "type": "timeseries",
          "description": "Open/submitted Drafts with a non-invalidated conflicting candidate matching the current Draft version, base commit and main ref. Historical candidates are excluded. Unevaluated Drafts are not counted; zero does not prove every Draft is conflict-free.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 54,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "clumsies_drafts_with_reconciliation_conflicts",
              "legendFormat": "drafts",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
