{
  "uid": "clumsies-api",
  "title": "Clumsies Business API",
  "tags": [
    "clumsies",
    "en"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "API request performance and correlation by route and method.",
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/clumsies-overview/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "API",
      "type": "link",
      "url": "/d/clumsies-api/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Websites",
      "type": "link",
      "url": "/d/clumsies-web/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/clumsies-infrastructure/view",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "App entrance logs",
      "type": "link",
      "url": "/d/clumsies-web/view?var-site=app.clumsies.ai&viewPanel=5",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 3,
      "title": "Request throughput",
      "type": "timeseries",
      "description": "Five-minute API response rate by HTTP status, including background polling.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(clumsies_http_requests_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "All",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum by(status)(rate(clumsies_http_requests_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "HTTP {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP other"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Other responses"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Response samples",
      "type": "timeseries",
      "description": "Extrapolated response samples over five minutes, grouped by result.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",method!=\"\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "All",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "Successful",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(sum by(status_class)(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"4xx|5xx|other\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{status_class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Other"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 1,
      "title": "Successful response latency",
      "type": "timeseries",
      "description": "Five-minute quantiles for 2xx/3xx handlers, ending at Response return.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.5, sum by(le) (rate(clumsies_http_request_duration_seconds_bucket{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx\",method!=\"\"}[5m]))) and (sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx\",method!=\"\"}[5m])) > 0)) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(histogram_quantile(0.95, sum by(le) (rate(clumsies_http_request_duration_seconds_bucket{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx\",method!=\"\"}[5m]))) and (sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx\",method!=\"\"}[5m])) > 0)) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(histogram_quantile(0.99, sum by(le) (rate(clumsies_http_request_duration_seconds_bucket{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx\",method!=\"\"}[5m]))) and (sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx\",method!=\"\"}[5m])) > 0)) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "links": [
        {
          "title": "Request logs",
          "url": "/d/clumsies-api/view?${__url_time_range}&viewPanel=5&var-route=${route:percentencode}&var-method=${method:percentencode}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Slow request routes",
      "type": "timeseries",
      "description": "Requests exceeding one second over five minutes, showing the top eight routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(topk(8, sum by(route)(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",method!=\"\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m])) - sum by(route)(increase(clumsies_http_request_duration_seconds_bucket{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",le=~\"1|1[.]0\",method!=\"\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m])))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "links": [
            {
              "title": "Business API",
              "url": "/d/clumsies-api/view?${__url_time_range}&var-route=${__field.labels.route}&var-method=${method:percentencode}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Busiest routes",
      "type": "timeseries",
      "description": "Top eight routes by five-minute request rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(topk(8,sum by(route)(rate(clumsies_http_requests_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",method!=\"\"}[5m])))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "links": [
            {
              "title": "Business API",
              "url": "/d/clumsies-api/view?${__url_time_range}&var-route=${__field.labels.route}&var-method=${method:percentencode}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "title": "5xx ratio",
      "type": "timeseries",
      "description": "5xx responses as a share of all responses for the selected route and method.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",route=~\"$route\",method=~\"$method\",status_class=\"5xx\"}[5m])) or 0 * sum(rate(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m]))) / (sum(rate(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m])) > 0) * 100) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "title": "5xx responses",
      "type": "timeseries",
      "description": "Extrapolated 5xx responses over five minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 7,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",route=~\"$route\",method=~\"$method\",status_class=\"5xx\"}[5m])) or 0 * sum(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",method!=\"\",route=~\"$route\",method=~\"$method\",status_class=~\"2xx|3xx|4xx|5xx|other\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 24,
      "title": "Request lifecycle",
      "type": "timeseries",
      "description": "API handler starts, responses and interruptions, including background polling.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(clumsies_http_business_requests_started_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "Started",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum by(outcome)(rate(clumsies_http_business_requests_terminated_total{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",method!=\"\"}[5m]))) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "response"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Responses"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled_or_aborted"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Interrupted"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "title": "Error response latency",
      "type": "timeseries",
      "description": "Five-minute p95 for 4xx, 5xx and other results.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95,sum by(le,status_class)(rate(clumsies_http_request_duration_seconds_bucket{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"4xx|5xx|other\",method!=\"\"}[5m]))) and on(status_class) (sum by(status_class)(increase(clumsies_http_request_duration_seconds_count{job=\"server\",route!~\"/metrics|/api/v1/admin/health\",route=~\"$route\",method=~\"$method\",status_class=~\"4xx|5xx|other\",method!=\"\"}[5m])) > 0)) and on() (min(up{job=\"server\"}) == 1)",
          "legendFormat": "{{status_class}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "other p95"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Other p95"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Slow backend requests",
      "type": "logs",
      "description": "Handler requests exceeding one second, filtered by route and method.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"server\"} | json method=\"span.method\", route=\"span.route\", duration_ms=\"fields.duration_ms\", message=\"fields.message\", request_id=\"span.request_id\", status=\"fields.status\" | message=\"http request completed\" | route!~\"/metrics|/api/v1/admin/health\" | route=~\"${route:regex}\" | method=~\"${method:regex}\" | duration_ms > 1000 | __error__=\"\" | line_format \"{{.route}} · {{.duration_ms}} ms · HTTP {{.status}} · request_id={{.request_id}}\"",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showLabels": false
      }
    },
    {
      "id": 7,
      "title": "Request correlation",
      "type": "logs",
      "description": "Exact internal or client request ID match; an empty ID returns no logs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"caddy|server\"} |= ${request_id:doublequote} | json edge_request_id=\"request_id\", server_request_id=\"span.request_id\", client_request_id=\"span.client_request_id\" | __error__=\"\" | (edge_request_id!=\"\" and edge_request_id!=\"missing\" and edge_request_id=${request_id:doublequote}) or (server_request_id!=\"\" and server_request_id!=\"missing\" and server_request_id=${request_id:doublequote}) or (client_request_id!=\"\" and client_request_id!=\"missing\" and client_request_id=${request_id:doublequote})",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showLabels": false
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Product activity",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 101,
          "title": "Snapshot status",
          "type": "stat",
          "description": "Database and host snapshots are valid for 15 minutes.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 41,
            "w": 12,
            "h": 4
          },
          "targets": [
            {
              "refId": "A",
              "expr": "((clumsies_database_collection_success and on(job,instance) (((time() - clumsies_database_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) <= 900)) and on(job,instance) (((time() - clumsies_observability_collection_timestamp_seconds) >= 0) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) <= 900))) or on(job,instance) ((0 * clumsies_database_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_database_collection_timestamp_seconds) < 0)) or on(job,instance) ((0 * clumsies_observability_collection_timestamp_seconds - 2) and on(job,instance) ((time() - clumsies_observability_collection_timestamp_seconds) < 0)) or on(job,instance) (0 * up{job=\"node\"} - 1)) or on() vector(-1)",
              "legendFormat": "Database",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "instant": true,
              "range": false
            }
          ],
          "fieldConfig": {
            "defaults": {
