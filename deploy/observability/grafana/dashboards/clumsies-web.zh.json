            "selected": false
          },
          {
            "text": "app.clumsies.ai",
            "value": "app.clumsies.ai",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "request_id",
        "label": "请求编号",
        "type": "textbox",
