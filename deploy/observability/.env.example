# Grafana administrator password (any random string).
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password

# Read-only metrics access to the running PostgreSQL instance. Build the DSN from
# the same credentials the Server uses in /opt/clumsies/.env.
CLUMSIES_POSTGRES_DSN=postgresql://clumsies:replace-with-the-database-password@postgres:5432/clumsies?sslmode=disable
