          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clumsies 正在 macOS 临时隔离路径中运行。请退出应用，将 Clumsies.app 移至 /Applications 或 ~/Applications，再重新打开。守护进程和 Agent 集成均未更改。"
          }
        }
