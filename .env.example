# Docker Compose Server and PostgreSQL
CLUMSIES_SERVER_IMAGE=ghcr.io/lilhammerfun/clumsies-server@sha256:replace-with-published-image-digest
CLUMSIES_SERVER_PORT=8080
CLUMSIES_DB_PORT=5432
CLUMSIES_DB_NAME=clumsies
CLUMSIES_DB_USER=clumsies
CLUMSIES_DB_PASSWORD=replace-with-a-random-password

# Required by Server and Caddy. Server derives its OIDC callback and same-origin
# Admin callback from this origin. Caddy obtains and renews TLS certificates.
CLUMSIES_PUBLIC_ORIGIN=https://memory.example.com

# One-time secret used to claim an uninitialized Server at /admin/setup.
# Generate at least 32 random characters. It may be unset after setup completes.
CLUMSIES_SETUP_CODE=replace-with-at-least-32-random-characters

# Enterprise OIDC. Register the callback URL with the organization's IdP.
CLUMSIES_OIDC_ISSUER=https://identity.example.com
CLUMSIES_OIDC_CLIENT_ID=replace-with-oidc-client-id
CLUMSIES_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret

# Redirects back to trusted Clumsies clients after OIDC. Desktop listens on an
# ephemeral loopback port, so omitting its port allows any dynamic 127.0.0.1
# port with this exact path. The same-origin Web Admin callback is derived from
# CLUMSIES_PUBLIC_ORIGIN and does not belong in this list.
CLUMSIES_CLIENT_REDIRECT_URIS=http://127.0.0.1/callback

# Browser origins for Web Admin or local web development. Desktop traffic is
# native and goes through daemon, so it does not depend on CORS.
CLUMSIES_CORS_ORIGINS=http://127.0.0.1:1421,http://localhost:1421

# Optional Project Episode summarization. Without these, Evidence is still
# stored durably; pending Episodes can be explicitly rebuilt after enabling it.
CLUMSIES_EPISODE_SUMMARY_API_KEY=
CLUMSIES_EPISODE_SUMMARY_MODEL=
CLUMSIES_EPISODE_SUMMARY_BASE_URL=https://api.openai.com/v1
